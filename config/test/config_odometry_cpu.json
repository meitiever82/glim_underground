{
  /*** Keyframe-based VGICP odometry estimation (CPU) ***
  // Matching mid360 GPU pipeline but using CPU backend
  // registration_type: "VGICP" to match GPU's VGICP algorithm
  */
  "odometry_estimation": {
    "so_name": "libodometry_estimation_cpu.so",
    // Initialization params (matching mid360 GPU)
    "initialization_mode": "LOOSE",
    "initialization_window_size": 1.0,
    "init_pose_damping_scale": 1e10,
    // Optimizer params
    "smoother_lag": 5.0,
    "use_isam2_dogleg": false,
    "isam2_relinearize_skip": 1,
    "isam2_relinearize_thresh": 0.1,
    "fix_imu_bias": false,
    // Registration settings - use VGICP to match GPU pipeline
    "registration_type": "VGICP",
    "max_iterations": 8,
    "lru_thresh": 100,
    "target_downsampling_rate": 0.1,
    // GICP + iVox params (not used when registration_type is VGICP)
    "ivox_resolution": 1.0,
    "ivox_min_dist": 0.1,
    // VGICP params - matching mid360 GPU voxel settings
    "vgicp_resolution": 0.1,
    "vgicp_voxelmap_levels": 2,
    "vgicp_voxelmap_scaling_factor": 2.0,
    // MISC
    "save_imu_rate_trajectory": true,
    "num_threads": 4
  }
}
